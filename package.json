{
  "name": "cortico-world-music",
  "version": "0.2.0",
  "type": "module",
  "description": "一起感受音乐——在用户明确要求后，和桌宠一起听电脑上的音乐：系统环回采集、播放器曲目信息与完整歌词、云端沉浸式感受；会结合歌手风格/年代/出处场景理解歌曲，听歌时保持专注不打盹；支持自定义 OpenAI 兼容接口/模型和自己的 Key，听完一首可继续或停；带一点大肥鱼的傻白甜，开心会傻乐走动，难过会安静发呆（只用现有动作）。只支持 Windows。",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "music",
    "audio",
    "listening",
    "wasapi",
    "loopback",
    "qwen-omni"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "一起感受音乐",
    "tags": [
      "voice",
      "requires-key",
      "sensitive-data",
      "experimental"
    ],
    "describe": "describe.json",
    "webUiClient": "dist/webui.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "PROJECT.md",
    "CHANGELOG.md",
    "describe.json",
    "LICENSE"
  ],
  "scripts": {
    "build:webui": "node scripts/build-webui.mjs",
    "prepare": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webui.json"
  },
  "dependencies": {
    "loopback-capture": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
